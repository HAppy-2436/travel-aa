/* pages/capture/capture.wxss */

.card-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-hint);
  line-height: 1.7;
}

.shot-box {
  margin-top: 28rpx;
  height: 360rpx;
  border: 3rpx dashed var(--gray-300);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--gray-50);
  overflow: hidden;
}

.shot-img {
  width: 100%;
  height: 100%;
}

.shot-icon {
  font-size: 72rpx;
}

.shot-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-hint);
}

.shot-busy {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--primary);
}

.result-head {
  margin: 32rpx 0 8rpx;
}

.result-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}
