/* pages/add-bill/add-bill.wxss */

/* ===== AI 一句话记账 ===== */
.ai-card {
  background: linear-gradient(135deg, #f3f0ff 0%, #eef6ff 100%);
  border: 2rpx solid #e4dcff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.ai-card-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.ai-badge {
  font-size: 28rpx;
  font-weight: 700;
  color: #5b3df5;
}

.ai-sub {
  font-size: 22rpx;
  color: #7a6f9e;
}

.ai-input {
  width: 100%;
  min-height: 96rpx;
  background: #fff;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.ai-samples {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ai-sample {
  font-size: 22rpx;
  color: #5b3df5;
  background: rgba(91, 61, 245, 0.08);
  border-radius: 12rpx;
  padding: 12rpx 18rpx;
}

.ai-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.ai-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.ai-btn-primary {
  background: #5b3df5;
  color: #fff;
}

.ai-btn-ghost {
  background: rgba(255, 255, 255, 0.7);
  color: #5b3df5;
}

.ai-result {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx;
}

.ai-result-title {
  font-size: 22rpx;
  color: #8a80ab;
  margin-bottom: 16rpx;
}

.ai-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ai-chip {
  font-size: 24rpx;
  color: #3d2f7c;
  background: #f0ecff;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.ai-warn {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #d97706;
}

.ai-ok {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #059669;
}

.page-hero {
  padding: 40rpx 0 48rpx;
}

.split-member {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 0;
}

.split-member-name {
  font-size: 28rpx;
  font-weight: 600;
  width: 120rpx;
}

/* 底部栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 48rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 2rpx solid var(--gray-100);
  z-index: 100;
}
