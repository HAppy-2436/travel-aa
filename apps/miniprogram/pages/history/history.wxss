/* pages/history/history.wxss */
.stat-bar-item {
  margin-bottom: 24rpx;
}

.stat-bar-label {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
  font-size: 26rpx;
}

.stat-bar-value {
  font-weight: 600;
  color: var(--primary);
}

.stat-bar-track {
  height: 24rpx;
  background: var(--bg-page);
  border-radius: 12rpx;
  overflow: hidden;
}

.stat-bar-fill {
  height: 100%;
  border-radius: 12rpx;
  transition: width 0.5s ease;
  min-width: 4rpx;
}

/* 分类条一律单色（对齐网页 Demo 的黑条），不再 6 色彩虹 */
.stat-bar-fill.tag-food { background: var(--text-primary); }
.stat-bar-fill.tag-transport { background: var(--text-primary); }
.stat-bar-fill.tag-hotel { background: var(--text-primary); }
.stat-bar-fill.tag-ticket { background: var(--text-primary); }
.stat-bar-fill.tag-shopping { background: var(--text-primary); }
.stat-bar-fill.tag-other { background: var(--gray-500); }

.stat-bar-percent {
  font-size: 22rpx;
  color: var(--text-hint);
  display: block;
  text-align: right;
  margin-top: 4rpx;
}

.bill-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.bill-item:last-child {
  border-bottom: none;
}

.bill-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.bill-info {
  flex: 1;
}

.bill-desc {
  font-size: 28rpx;
  display: block;
}

.bill-meta {
  font-size: 22rpx;
  color: var(--text-hint);
  display: block;
}

.bill-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.empty-icon-small {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}
