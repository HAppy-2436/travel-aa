<!-- pages/history/history.wxml -->
<view class="container">
  <view class="card fade-in">
    <view class="card-title">📊 消费统计</view>
    <view class="chart-area">
      <!-- 简单的分类统计 -->
      <view wx:for="{{categoryStats}}" wx:key="id" class="stat-bar-item">
        <view class="stat-bar-label">
          <text>{{item.icon}} {{item.name}}</text>
          <text class="stat-bar-value">¥{{item.amountText}}</text>
        </view>
        <view class="stat-bar-track">
          <view class="stat-bar-fill {{item.tagClass}}" style="width: {{item.percent}}%"></view>
        </view>
        <text class="stat-bar-percent">{{item.percentText}}%</text>
      </view>
    </view>
  </view>

  <!-- V2：每日消费分析 -->
  <view class="card fade-in" wx:if="{{dailyInfo}}">
    <view class="card-title">📅 每日消费分析</view>
    <view style="display:flex; justify-content:space-between; font-size: 24rpx; color:#666; margin-bottom: 12rpx;">
      <text>日均 ¥{{dailyInfo.dailyAvgText}}</text>
      <text wx:if="{{dailyInfo.maxDay}}">最贵一天 {{dailyInfo.maxDay.date}} ¥{{dailyInfo.maxDay.totalText}}</text>
      <text wx:if="{{dailyInfo.trend === 'up'}}" style="color:#FA9D3B;">📈 越花越多</text>
      <text wx:elif="{{dailyInfo.trend === 'down'}}" style="color:#07C160;">📉 越花越省</text>
    </view>
    <view wx:for="{{dailyInfo.days}}" wx:key="date" class="stat-bar-item">
      <view class="stat-bar-label">
        <text>{{item.date}} {{item.weekday}}</text>
        <text class="stat-bar-value">¥{{item.totalText}} · {{item.count}}笔</text>
      </view>
      <view class="stat-bar-track">
        <view class="stat-bar-fill" style="width: {{dailyInfo.maxDay ? item.total / dailyInfo.maxDay.total * 100 : 0}}%"></view>
      </view>
    </view>
  </view>

  <view class="card fade-in">
    <view class="card-title">📝 完整账单记录</view>

    <!-- 分类筛选 -->
    <view class="dest-pills" style="margin-bottom: 16rpx;">
      <view wx:for="{{filterOptions}}" wx:key="id"
        class="dest-pill {{filterType === item.id ? 'dest-pill-active' : ''}}"
        bindtap="setFilter" data-type="{{item.id}}">
        {{item.icon}} {{item.name}}
      </view>
    </view>

    <view wx:for="{{filteredBills}}" wx:key="_id" class="bill-item" bindtap="editBill" data-bill="{{item}}">
      <view class="bill-icon">{{item.categoryIcon}}</view>
      <view class="bill-info">
        <text class="bill-desc">{{item.description}}</text>
        <text class="bill-meta">{{item.payerName}} · {{item.timeStr}} · 点击编辑</text>
      </view>
      <text class="bill-amount">{{item.amountLabel}}</text>
      <text class="bill-meta" style="margin-left: 12rpx; color:#FA5151;" catchtap="deleteBill" data-id="{{item._id}}">删除</text>
    </view>

    <view wx:if="{{filteredBills.length === 0}}" class="empty-state">
      <text class="empty-icon-small">📝</text>
      <text class="empty-text">暂无账单记录</text>
    </view>
  </view>
</view>
