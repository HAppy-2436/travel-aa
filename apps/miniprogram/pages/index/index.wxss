/* pages/index/index.wxss */

/* ===== Hero ===== */
.hero {
  padding: 60rpx 0 70rpx;
}

.hero-label {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
  color: var(--gray-400);
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 76rpx;
  font-weight: 700;
  letter-spacing: -3rpx;
  line-height: 1.1;
  display: block;
}

.hero-title-sub {
  color: var(--gray-300);
}

/* ===== 操作按钮 ===== */
.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 60rpx;
}

/* ===== 弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal {
  width: 100%;
  background: var(--white);
  border-radius: 56rpx 56rpx 0 0;
  max-height: 85vh;
  overflow-y: auto;
}

.modal-handle {
  width: 64rpx;
  height: 6rpx;
  background: var(--gray-200);
  border-radius: 3rpx;
  margin: 20rpx auto 0;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 48rpx 24rpx;
}

.modal-title {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--gray-50);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--gray-600);
}

.modal-body {
  padding: 0 48rpx;
}

.modal-footer {
  padding: 36rpx 48rpx calc(36rpx + env(safe-area-inset-bottom));
}

.dest-scroll {
  white-space: nowrap;
}

.room-code-input {
  text-align: center;
  font-size: 44rpx;
  letter-spacing: 16rpx;
  font-weight: 700;
}
