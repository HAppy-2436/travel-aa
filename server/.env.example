# TravelAA 服务端 AI 配置（复制为 .env 后填写，勿提交密钥）
# 支持图片输入的 OpenAI 兼容接口即可（vision 能力）
# 注：未设置 LLM_API_KEY 时，服务端自动读取环境变量 DEEPSEEK_API_KEY（密钥可不落盘）

# API Key（留空则用环境变量 DEEPSEEK_API_KEY）
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 模型服务商 Base URL（OpenAI 兼容 /chat/completions）
# 常见示例：
#   DeepSeek:  https://api.deepseek.com/v1   （模型 deepseek-flash / deepseek-v4-pro）
#   OpenAI:    https://api.openai.com/v1
#   智谱 GLM:  https://open.bigmodel.cn/api/paas/v4
#   阿里百炼:  https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 文本解析模型
LLM_MODEL=deepseek-flash

# 视觉识图模型（支持图片输入；不填则用 LLM_MODEL）
VISION_MODEL=deepseek-flash

# 可选：关闭端侧 NPU 回退（云端配置好后置 0 可省 ~8GB 内存）
# NPU_FALLBACK=0
